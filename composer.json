{
    "name": "aryeo/request-casts",
    "type": "library",
    "repositories": {
        "tooling-laravel": {
            "type": "vcs",
            "url": "https://github.com/AryeoHQ/tooling-laravel"
        }
    },
    "require": {
        "laravel/framework": "^12.37 || ^13"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6 || ^11",
        "aryeo/tooling-laravel": "0.0.40",
        "phpunit/phpunit": "^12.4.1 || ^13",
        "nesbot/carbon": "^3.10",
        "orchestra/testbench-core": "^10.7 || ^11",
        "pestphp/pest": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "tooling": {
            "phpstan": {
                "config": {
                    "paths": [
                        "./src",
                        "./tests"
                    ]
                }
            },
            "rector": {
                "config": {
                    "paths": [
                        "./src",
                        "./tests"
                    ]
                }
            },
            "pint": {
                "config": {
                    "paths": [
                        "./src",
                        "./tests"
                    ]
                }
            }
        }
    },
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true,
            "pestphp/pest-plugin": true
        }
    }
}
